// This file uses JSONC syntax.
{
  "server": {
    "host": "localhost",        // host name or IP address
    "port": "9000",             // port name or number
    "socket": "",               // If socket is non-empty, host and port are ignored
    "cors_allowed_origins": "*",
  },
  "shell": {
    "umask": "022",              // octal string
    "cwd": ".",
    "path": "/usr/bin/zsh",
    "args": ["zsh", "--login"],
    "env": {
      "HOME": "{HOME}",
      "TERM": "xterm-256color",
    },
  },
}
